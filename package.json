{
  "name": "uy-navbat-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kvartira tozalash navbati uchun Telegram bot",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "start:prod": "node dist/index.js",
    "db:setup": "tsx src/db/setup.ts",
    "db:seed": "tsx src/db/seed.ts",
    "commands:set": "tsx src/scripts/commands.ts",
    "webhook:set": "tsx src/scripts/webhook.ts set",
    "webhook:info": "tsx src/scripts/webhook.ts info",
    "webhook:delete": "tsx src/scripts/webhook.ts delete",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.32.0",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@vercel/node": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
